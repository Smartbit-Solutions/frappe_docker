# Smartbit Solutions Custom ERPNext Configuration
# Copy this file to .env and customize the values

# Custom image settings - points to your locally built image
CUSTOM_IMAGE=smartbit-erp
CUSTOM_TAG=latest
PULL_POLICY=missing

# Database password (CHANGE THIS!)
DB_PASSWORD=change_this_secure_password_123

# Only if you use docker secrets for the db password
DB_PASSWORD_SECRETS_FILE=

# Only if you use external database
DB_HOST=
DB_PORT=

# Only if you use external Redis
REDIS_CACHE=
REDIS_QUEUE=

# Only with HTTPS override
LETSENCRYPT_EMAIL=mail@example.com

# Optional: Site name override
# Default resolves by host (e.g., if host is 127.0.0.1, site name is 127.0.0.1)
FRAPPE_SITE_NAME_HEADER=

# Default value is `8080`
HTTP_PUBLISH_PORT=8080

# Default value is `127.0.0.1`. Set IP address as our trusted upstream address.
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1

# Default value is `X-Forwarded-For`
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For

# Allowed values are on|off. Default value is `off`
UPSTREAM_REAL_IP_RECURSIVE=off

# Default value is 120s
PROXY_READ_TIMEOUT=120s

# Default value is 50m
CLIENT_MAX_BODY_SIZE=50m

# Single site: SITES_RULE=Host(`erp.example.com`)
# Multiple sites: SITES_RULE=Host(`a.example.com`) || Host(`b.example.com`)
SITES_RULE=Host(`erp.example.com`)
